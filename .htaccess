DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^module\.php$ module_release.php [L]
</IfModule>

<FilesMatch "^(index\.html|auth\.php|auth_store\.php|backup_lib\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db|log|zip)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
