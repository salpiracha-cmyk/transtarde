  "postingRules": [
    {
      "event": "UTILITY_PAYMENT",
      "debit": "expense account selected from approved Utilities master",
      "credit": "selected bank/cash account",
      "rule": "No ledger entry merely because the bill arrives. If a prior period-end accrual exists, debit accrued-expense liability instead of expense on settlement."
    },
    {
      "event": "CREDIT_CARD_PAYMENT",
      "debit": "approved split: business expense accounts and/or family personal-allocation subledgers",
      "credit": "selected bank/cash account",
      "rule": "Personal portions never remain in company operating expense. Period-end outstanding material card costs are subject to cutoff/accrual review."
    },
    {
      "event": "EXPENSE_REIMBURSEMENT_CAPTURE",
      "debit": "approved business expense",
      "credit": "person-specific reimbursement payable",
      "rule": "Use expense date for recognition. Company Cars requires no vehicle number."
    },
    {
      "event": "EXPENSE_REIMBURSEMENT_SETTLE",
      "debit": "person-specific reimbursement payable",
      "credit": "selected bank/cash account",
      "rule": "Settlement does not create another expense."
    },
    {
      "event": "COMMODITY_RECEIPT_ACCEPTED",
      "debit": "commodity inventory",
      "credit": "GRNI / unbilled supplier-broker liability",
      "rule": "Idempotent by source Soda + truck/Pohanch reference. Quantity/value must come from approved operational receipt, not retyped in Accounts."
    },
    {
      "event": "COMMODITY_BILL_VERIFIED",
      "debit": "GRNI plus approved purchase/variance/brokerage/tax accounts as required",
      "credit": "supplier/broker payable plus withholding/tax payable as required",
      "rule": "Brokerage and tax percentages are effective-dated Accounts Master rules and must not be hard-coded. Manual exceptions require authorization."
    },
    {
      "event": "SUPPLIER_PAYMENT",
      "debit": "supplier/broker payable",
      "credit": "selected bank/cash account",
      "rule": "Can settle one or multiple Soda/bills with traceable allocations."
    },
    {
      "event": "SUPPLIER_ADVANCE",
      "debit": "1250 Supplier / Service Advances",
      "credit": "selected bank/cash or settlement source",
      "rule": "Advance remains an asset until allocated to the related supplier/service bill or otherwise recovered/refunded."
    },
    {
      "event": "CUSTOMER_ADVANCE_RECEIVED",
      "debit": "selected bank/cash or approved settlement source",
      "credit": "2510 Customer Advances / Unapplied Receipts",
      "rule": "Use before sale/receivable recognition or while invoice allocation remains genuinely unknown. Allocate against the receivable only after the underlying sale is recognized."
    },
    {
      "event": "THIRD_PARTY_PAYMENT_ON_BEHALF",
      "debit": "supplier/service payable or correct expense/asset/inventory",
      "credit": "customer receivable, customer advance, 2520 Due to Third Parties, or intercompany payable according to the actual payer relationship",
      "rule": "Never invent a company bank movement. Preserve payer, beneficiary, linked transaction and settlement reason."
    },
    {
      "event": "LOCAL_SALE_RECOGNIZED",
      "debit": "local-sale receivable or advance clearing",
      "credit": "local sales revenue",
      "rule": "Revenue recognition event is configured to the point at which control passes; actual loaded quantity drives billing. Cost-of-sales posting is paired from inventory cost."
    },
    {
      "event": "EXPORT_SALE_RECOGNIZED",
      "debit": "export receivable",
      "credit": "export sales revenue",
      "rule": "Recognition is based on the approved control-transfer event from contract/Incoterm. Customs/commercial document creation alone is not the trigger. Currency and PKR reporting amounts are retained."
    },
    {
      "event": "EXPORT_RECEIPT",
      "debit": "bank / USD retention account",
      "credit": "export receivable or 2510 Customer Advances / Unapplied Receipts as appropriate",
