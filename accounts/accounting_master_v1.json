{
  "version": 2,
  "framework": {
    "baseline": "UK GAAP / FRS 102",
    "effectiveBasis": "Periodic Review 2024 amendments effective for periods beginning on or after 2026-01-01",
    "rule": "Business-language workflows may never override correct double-entry, recognition, classification, legal-entity separation or audit-trail requirements.",
    "localCompliance": "Each legal entity remains subject to its own statutory, tax, payroll, disclosure and audit requirements. UK GAAP is the design baseline, not a substitute for local law.",
    "revenueRecognition": "Post revenue only at the approved control-transfer event derived from the contract / Incoterm / delivery terms. Creating a contract, invoice, customs document or packing list alone does not prove revenue recognition.",
    "inventory": "Commodity receipts are inventory assets, not operating expenses. Use unbilled-liability / GRNI controls where goods are accepted before the supplier/broker bill is finalized.",
    "periodCutoff": "Reminder-only workflows for utilities, cards, salaries and rent do not create ledger entries on receipt of a bill. Period close must nevertheless identify material incurred-but-unrecorded costs and require an accrual or documented review before locking the period."
  },
